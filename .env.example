# Copy to .env.local (never committed) and adapt. Online, the same settings go in Vercel's environment variables.

# --- AI editor -------------------------------------------------------------
# "claude" (online, used in production), "mistral", or "ollama" (on the Mac, development).
PLOMB_AI_PROVIDER=ollama
# Claude API key (console.anthropic.com → API keys). Paste it here yourself, never in a chat or on GitHub.
ANTHROPIC_API_KEY=
# Optional model name (Claude: claude-haiku-5-5 by default · Ollama: ministral-3:14b by default).
# PLOMB_AI_MODEL=

# --- Online only -----------------------------------------------------------
# DATABASE_URL=libsql://…turso.io
# DATABASE_AUTH_TOKEN=
# PLOMB_PASSWORD=
# CRON_SECRET=
# RESEND_API_KEY=
# PLOMB_EMAIL_TO=
# PLOMB_APP_URL=https://…vercel.app

# --- Test phase --------------------------------------------------------------
# The edition takes everything until now, including recent articles from before the subscription.
PLOMB_EDITION_TEST=1
