# Copy to .env.local (never committed) and adapt. Online, the same settings go in Vercel's environment variables.

# --- AI editor -------------------------------------------------------------
# "mistral" (online, used in production) or "ollama" (on the Mac, development).
PLOMB_AI_PROVIDER=ollama
# Mistral API key (console.mistral.ai → API keys). Paste it here yourself, never in a chat or on GitHub.
MISTRAL_API_KEY=
# Model name (Mistral: mistral-small-latest · Ollama: ministral-3:14b).
PLOMB_AI_MODEL=ministral-3:14b

# --- Test phase --------------------------------------------------------------
# The edition takes everything until now, including recent articles from before the subscription.
PLOMB_EDITION_TEST=1
